{
  "name": "@egy186/eslint-config",
  "version": "4.8.0",
  "description": "Eslint shareable config",
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "homepage": "https://github.com/egy186/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/egy186/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egy186/eslint-config.git"
  },
  "license": "MIT",
  "author": "egy186",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "default": "./dist/typescript.js"
    },
    "./typescript-react": {
      "types": "./dist/typescript-react.d.ts",
      "default": "./dist/typescript-react.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/test-utils",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "npm run build -- --clean",
    "lint": "eslint",
    "prepare": "husky",
    "pretest": "npm run build",
    "test": "node --test **/*.test.js"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "~5.10.0",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-jsdoc": "~64.3.3",
    "eslint-plugin-n": "~18.3.0",
    "globals": "^17.11.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "~5.18.6",
    "@eslint/js": "~10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/eslint-plugin": "~1.6.27",
    "eslint": "~10.9.1",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.69.0"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@vitest/eslint-plugin": "^1.6.13",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.0.4 || ^6.0.2",
    "typescript-eslint": "^8.53.0"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
